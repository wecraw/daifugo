# Copy to `.env.native` (gitignored) before running `npm run ios:build`.
#
# The iOS app's pages come from `capacitor://localhost`, so unlike the web build
# it has to be told where the server is. Both values are baked into the bundle at
# build time — rebuild and re-sync after changing either.

# The deployed server's origin. Must be https:// (iOS App Transport Security
# blocks cleartext), except for localhost during development.
VITE_SERVER_URL=https://daifugo-xxxxxxxxxx-uc.a.run.app

# Where the web client is reachable, for the invite link the lobby's share button
# copies. Defaults to VITE_SERVER_URL, which is correct while the server is also
# what serves the web client (§14) — set it only if that ever stops being true.
# VITE_PUBLIC_WEB_URL=https://daifugo.example.com
